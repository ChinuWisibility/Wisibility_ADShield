# =============================================================================
# ICM Backend — environment template
# =============================================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in secrets in .env (never commit real passwords/keys to git)
# 3. The app loads .env via src/config/env.js (dotenv)
# =============================================================================

# --- Server ---
# Use 8082 for local npm run dev so it does not clash with ADSecurity.API on 8081.
PORT=8082
HOST=0.0.0.0
NODE_ENV=development
# TRUST_PROXY=1
# Maintenance mode (Super Admin > Platform Settings) is only enforced when
# NODE_ENV=production. Set this to true to exercise it locally.
# MAINTENANCE_MODE_ENFORCE=true
# Production break-glass recovery: set true and restart the API if Super Admin
# authentication is unavailable while maintenance is enabled. Remove after use.
# MAINTENANCE_MODE_FORCE_OFF=true

# --- Database ---
MONGODB_URI=mongodb://user:password@host:27017/?tls=true
DB_NAME=ADShield

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=24h
ADMIN_PASSWORD=change-me
# Temporary/demo initial password for portal Users created from "New Identity".
# Do not commit a production value. Never expose this in the frontend.
# DEFAULT_INITIAL_PASSWORD=
# Create Own Password link TTL for identity onboarding only (forgot-password unchanged).
# IDENTITY_ONBOARDING_TOKEN_TTL_DAYS=7

# --- Purpose-specific portal tokens ---
# Required. Each must be a distinct long random string, different from
# JWT_SECRET and from each other — these gate unauthenticated public review
# portals, so a shared/weak secret here is a real forgery risk. The app
# fails to start if any of these are unset.
CERTIFICATION_JWT_SECRET=change-me-to-a-different-long-random-string
REMEDIATION_TICKET_JWT_SECRET=change-me-to-a-different-long-random-string
ORPHAN_IAM_PORTAL_JWT_SECRET=change-me-to-a-different-long-random-string
CERT_SIGNOFF_SECRET=change-me-to-a-different-long-random-string
# CERTIFICATION_REVIEWER_JWT_TTL_HOURS=48

# --- CORS & URLs (emails + review links) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8082

# --- Upload ---
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# --- Email provider (any SMTP — not Gmail-only) ---
# Use your corporate SMTP or Gmail app password. Required: HOST/USER/PASS.
EMAIL_PROVIDER=smtp
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASS=
# Optional display / from overrides
# EMAIL_FROM_NAME=Wisibility IGA
# WORKFLOW_FROM_EMAIL=
# WORKFLOW_FROM_NAME=

# IAM orphan action emails go here (workflow uses $.config.iamTeamEmail — do not hardcode on canvas)
IAM_TEAM_EMAIL=

# --- Email queue & worker ---
EMAIL_RATE_LIMIT_PER_MIN=50
EMAIL_WORKER_POLL_MS=30000
EMAIL_WORKER_BATCH_SIZE=10
EMAIL_JOB_MAX_ATTEMPTS=4
EMAIL_JOB_STALE_MS=600000
# Jobs in PROCESSING longer than this are re-queued (default 10 min). Increase if sends are slow.

# --- Certification scheduler ---
# Poll interval in ms (3600000 = 1 hour; 300000 = 5 min)
CERT_POLL_INTERVAL_MS=3600000
# First automated REMINDER only after this grace from campaign start (ms). Default follows frequency (e.g. 7d for WEEKLY).
# CERT_FIRST_REMINDER_GRACE_MS=604800000

# --- Tenant-scoped email queries (after backfill) ---
# Rollout: node scripts/qa/tenantEmailBackfillReport.js --fix
TENANT_STRICT_EMAIL_QUERIES=false

# --- Queue health (GET /notifications/health) ---
EMAIL_HEALTH_FAILED_THRESHOLD=50
EMAIL_HEALTH_PENDING_AGE_MS=1800000

# --- Workflow Remediation Queue ---
# Automatic WRQ ingestion is disabled by default. Events are user-driven only.
WORKFLOW_REMEDIATION_SCHEDULER_ENABLED=false
# WORKFLOW_REMEDIATION_QUEUE_POLL_MS=3600000

# --- Product licensing (offline LMS validation at startup) ---
# Compatible with LMS LICENSE_ARTIFACT.md (format v1, schema 1.0, Base64URL, RS256).
# License lookup order (first match wins):
#   1) LICENSE_SEARCH_PATHS (default: config/license.lic.json, license/license.lic.json)
#   2) LICENSE_PATH (absolute or relative file path)
#   3) LICENSE_CONTENT (inline license JSON)
# Public keys: {LICENSE_KEYS_DIR}/{kid}/public.pem  (also accepts {kid}.pub)
# Align LICENSE_ISSUER / LICENSE_AUDIENCE / LICENSE_PRODUCT with the LMS-issued license.
# There is no environment flag to disable licensing.
# LICENSE_SEARCH_PATHS=config/license.lic.json,license/license.lic.json
# LICENSE_PATH=
# LICENSE_CONTENT=
# LICENSE_KEYS_DIR=./keys
# LICENSE_ISSUER=Wisibility
# LICENSE_AUDIENCE=ADSecurity
# LICENSE_PRODUCT=ADSecurity
# LICENSE_SCHEMA_VERSION=1.0
# LICENSE_ALLOWED_ALGS=RS256
# LICENSE_ALLOWED_HASHES=SHA-256
# LICENSE_ALLOWED_TYPES=Commercial,Trial,Evaluation,Educational,Internal,development

# --- Optional / advanced ---
# HRMS_SYNTHETIC_EMAIL_DOMAIN=sync.local

# --- JML provisioning workers ---
# Claims DETECTED/PENDING LifecycleEvents and runs JML orchestration. Default TRUE when unset.
# LIFECYCLE_WORKER_ENABLED=true
# Executes approved ProvisioningTasks against connectors. Default FALSE when unset —
# without it, approved requests compile a plan/task but nothing reaches the target system.
# PROVISIONING_WORKER_ENABLED=false
# Poll interval for the provisioning worker. Default 60000. Minimum honoured value 1000.
# PROVISIONING_WORKER_INTERVAL_MS=60000

# --- P5 generic Joiner orchestration cutover (server-only) ---
# Default FALSE when unset. When true, JOINER LifecycleEvents use the P1–P4
# generic plan path (policy → delta → plan → workflow → approval → tasks).
# REHIRE / MOVER / LEAVER are unchanged. No request/API override.
# Rollback: set false (or unset) and restart — future JOINER events use legacy.
# GENERIC_JML_ORCHESTRATION_ENABLED=false

# --- P7 generic MOVER decision/planning spine (server-only) ---
# Default FALSE when unset. When true, MOVER LifecycleEvents may run
# policy → actual access → delta → plan and persist request/plan.
# Still does NOT start workflow, create ProvisioningTasks, or invoke connectors.
# Flag OFF keeps P6 detection-only. No request/API override.
# GENERIC_MOVER_ORCHESTRATION_ENABLED=false

# --- AD Sync: Iteration #1 incremental graph edge writes ---
# Default TRUE when unset (dev). Only write edges whose membership identity changed.
# ENABLE_INCREMENTAL_GRAPH_UPDATES=true
#
# Instant disable (no code change):
#   1) touch icm-backend/.data/DISABLE_INCREMENTAL_GRAPH_UPDATES
#      (takes effect on the next flag check — no restart required)
#   2) Or set ENABLE_INCREMENTAL_GRAPH_UPDATES=false and restart the API
#
# Re-enable: delete the kill-switch file and ensure env is not false.
# Regression failures auto-create the kill-switch via validateAdSyncRegression.mjs.

# --- ADShield (.NET) live ACL / security-descriptor analysis ---
# Default FALSE. When true, broken_acls and unknown_sid_bindings are delegated
# to the ADShield service (live AD SD read). Node graph/SID detectors remain local.
# ADSHIELD_ENABLED=false
# ADSHIELD_BASE_URL=http://127.0.0.1:5088
# HTTP client timeout for ACL analysis (ms). Keep below frontend scan budget (600s).
# ADSHIELD_TIMEOUT_MS=180000
# Optional shared secret; when set, sent as X-ADShield-Key (configure the same on ADShield).
# ADSHIELD_API_KEY=
