# ADShield live proof credentials (NEVER commit this file)
# Copy to .env.local and fill with the same values used by IdentitySphere App Registry.

ADSHIELD_LDAP_URL=ldap://dc.example.local:389
ADSHIELD_BIND_DN=DOMAIN\svc_adshield
ADSHIELD_BIND_PASSWORD=
ADSHIELD_BASE_DN=DC=example,DC=local
ADSHIELD_OBJECT_DN=CN=Users,DC=example,DC=local
ADSHIELD_TLS_INSECURE=false
ADSHIELD_TIMEOUT_MS=30000
