{
  "name": "Access Revoke — Dual Notify & Close Ticket",
  "description": "Simple access-revoke flow: create an internal ticket, notify user and manager, verify both emails were queued, close the ticket on success, or fail the queue task if either notification fails.",
  "enabled": true,
  "tags": ["CERTIFICATION_REVOKE", "ACCESS_REVOKE"],
  "trigger": {
    "type": "CertificationSignedOff",
    "filter": { "decision": "Revoke" }
  },
  "nodes": [
    {
      "id": "trigger",
      "type": "CertificationSignedOff",
      "label": "Certification Signed Off",
      "position": { "x": 280, "y": 0 },
      "config": {
        "filterDecision": "Revoke",
        "description": "Fires when a reviewer signs off a revoke decision. Trigger data comes from the queue task."
      }
    },
    {
      "id": "createTicket",
      "type": "CreateTicket",
      "label": "Create Ticket (Internal)",
      "position": { "x": 280, "y": 120 },
      "config": {
        "provider": "internal",
        "title": "Access Revoke: {{$.trigger.identityName}} — {{$.trigger.entitlementName}}",
        "priority": "MEDIUM",
        "assignedTeam": "Identity Team",
        "identityName": "$.trigger.identityName",
        "identityEmail": "$.trigger.identityEmail",
        "managerName": "$.trigger.managerName",
        "managerEmail": "$.trigger.managerEmail",
        "applicationName": "$.trigger.applicationName",
        "entitlementName": "$.trigger.entitlementName",
        "reviewerName": "$.trigger.reviewerName",
        "reviewDate": "$.trigger.reviewDate",
        "comments": "$.trigger.comment",
        "description": "Access \"{{$.trigger.entitlementName}}\" on {{$.trigger.applicationName}} is being revoked for {{$.trigger.identityName}} (manager {{$.trigger.managerName}}) per certification {{$.trigger.campaignName}}. Reviewer: {{$.trigger.reviewerName}}."
      }
    },
    {
      "id": "emailUser",
      "type": "SendEmail",
      "label": "Notify User",
      "position": { "x": 280, "y": 240 },
      "config": {
        "to": "$.trigger.identityEmail",
        "from": "$.config.workflowFromEmail",
        "subject": "Access Revoked: {{$.trigger.entitlementName}} on {{$.trigger.applicationName}}",
        "body": "Hello {{$.trigger.identityName}},\n\nYour access \"{{$.trigger.entitlementName}}\" on {{$.trigger.applicationName}} is being revoked following certification {{$.trigger.campaignName}}.\n\nTicket: {{$.steps.createTicket.ticketId}}\n\nIf you believe this is an error, contact your manager {{$.trigger.managerName}} or the IAM team."
      }
    },
    {
      "id": "emailManager",
      "type": "SendEmail",
      "label": "Notify Manager",
      "position": { "x": 280, "y": 360 },
      "config": {
        "to": "$.trigger.managerEmail",
        "from": "$.config.workflowFromEmail",
        "subject": "Reportee Access Revoked: {{$.trigger.identityName}}",
        "body": "Hello {{$.trigger.managerName}},\n\n{{$.trigger.identityName}} had \"{{$.trigger.entitlementName}}\" on {{$.trigger.applicationName}} revoked following certification {{$.trigger.campaignName}}.\n\nTicket: {{$.steps.createTicket.ticketId}}"
      }
    },
    {
      "id": "userEmailSent",
      "type": "CompareStrings",
      "label": "User email sent?",
      "position": { "x": 280, "y": 480 },
      "config": {
        "left": "$.steps.emailUser.queued",
        "right": "true",
        "branchLabelTrue": "User OK",
        "branchLabelFalse": "User failed"
      }
    },
    {
      "id": "managerEmailSent",
      "type": "CompareStrings",
      "label": "Manager email sent?",
      "position": { "x": 180, "y": 600 },
      "config": {
        "left": "$.steps.emailManager.queued",
        "right": "true",
        "branchLabelTrue": "Both OK",
        "branchLabelFalse": "Manager failed"
      }
    },
    {
      "id": "closeTicket",
      "type": "CloseTicket",
      "label": "Close Ticket",
      "position": { "x": 80, "y": 720 },
      "config": {
        "provider": "internal",
        "ticketId": "$.steps.createTicket.ticketId",
        "resolution": "User and manager notified successfully."
      }
    },
    {
      "id": "updateQueue",
      "type": "UpdateQueueTask",
      "label": "Complete Queue Task",
      "position": { "x": 80, "y": 840 },
      "config": {
        "status": "COMPLETED",
        "description": "Both notifications sent; ticket closed."
      }
    },
    {
      "id": "auditSuccess",
      "type": "AuditLog",
      "label": "Audit Evidence",
      "position": { "x": 80, "y": 960 },
      "config": {
        "action": "ACCESS_REVOKE_WORKFLOW",
        "outcome": "SUCCESS",
        "message": "Access revoke notifications sent for {{$.trigger.identityName}} / {{$.trigger.entitlementName}}. Ticket {{$.steps.createTicket.ticketId}} closed."
      }
    },
    {
      "id": "endSuccess",
      "type": "EndSuccess",
      "label": "End — Success",
      "position": { "x": 80, "y": 1080 },
      "config": {}
    },
    {
      "id": "updateQueueFailed",
      "type": "UpdateQueueTask",
      "label": "Fail Queue Task",
      "position": { "x": 420, "y": 600 },
      "config": {
        "status": "FAILED",
        "description": "User or manager notification failed; ticket left open for follow-up."
      }
    },
    {
      "id": "endFailure",
      "type": "EndFailure",
      "label": "End — Failure (notify failed)",
      "position": { "x": 420, "y": 720 },
      "config": {}
    }
  ],
  "edges": [
    { "from": "trigger", "to": "createTicket" },
    { "from": "createTicket", "to": "emailUser" },
    { "from": "emailUser", "to": "emailManager" },
    { "from": "emailManager", "to": "userEmailSent" },
    { "from": "userEmailSent", "to": "managerEmailSent", "branch": "true" },
    { "from": "userEmailSent", "to": "updateQueueFailed", "branch": "false" },
    { "from": "managerEmailSent", "to": "closeTicket", "branch": "true" },
    { "from": "managerEmailSent", "to": "updateQueueFailed", "branch": "false" },
    { "from": "closeTicket", "to": "updateQueue" },
    { "from": "updateQueue", "to": "auditSuccess" },
    { "from": "auditSuccess", "to": "endSuccess" },
    { "from": "updateQueueFailed", "to": "endFailure" }
  ]
}
