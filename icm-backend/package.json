    "mssql": "^12.2.1",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.20.0",
    "nodemailer": "^9.0.3",
    "papaparse": "^5.5.3",
    "pdfkit": "^0.18.0",
    "pg": "^8.20.0",
    "streamifier": "^0.1.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
