{
  "name": "icm-backend",
  "version": "2.0.0",
  "description": "ADShield Platform - Backend API",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "build": "node scripts/build-dist.mjs",
    "build:dist": "node scripts/build-dist.mjs",
    "start": "node src/server.js",
    "start:prod": "node dist/server.js",
    "test": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --passWithNoTests",
    "bench:csv-mapped-import": "node src/scripts/csvImport/benchmarkCsvMappedImport.js --sizes=5000,50000,100000",
    "lint:posture": "eslint src/services/identity/posture/identityPostureDashboard.js src/services/identity/identityPostureService.js"
  },
  "dependencies": {
    "@aws-sdk/client-iam": "^3.1017.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.0.1",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "ldapts": "^8.1.8",
    "mongoose": "^8.9.2",
